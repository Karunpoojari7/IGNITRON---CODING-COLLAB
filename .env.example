# ==============================================================================
# IGNITRON 2K26 — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure all variables for your target platform.
# NEVER commit the active .env file or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production

# Backend HTTP service port (Render automatically injects PORT)
BACKEND_PORT=4000
PORT=4000

# Global REST API route prefix (e.g. "api" -> /api/health)
API_PREFIX=api

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTIVITY (MySQL 8.0+)
# ------------------------------------------------------------------------------
# Connection string syntax: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If using SSL/TLS (Render Managed MySQL / PlanetScale / Aiven / RDS):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict"
DATABASE_URL="mysql://username:password@hostname:3306/database_name"

# Local Docker Compose MySQL Credentials (used when running docker-compose up)
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=ignitron_2k26
MYSQL_USER=ignitron_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Strong 256-bit random secret string for JWT cookie signing
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_min_32_chars

# Session duration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. INITIAL SYSTEM ADMINISTRATOR BOOTSTRAP
# ------------------------------------------------------------------------------
# Used to seed the initial SUPER_ADMIN account on first backend boot
ADMIN_EMAIL=admin@yourcompetition.edu
ADMIN_PASSWORD=SetAStrongUniqueAdminPassword2026!
ADMIN_FULL_NAME=IGNITRON Tournament Director

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS) & DOMAIN ROUTING
# ------------------------------------------------------------------------------
# Production Vercel domain or custom tournament frontend URL
# Comma-separated if multiple domains are required
FRONTEND_URL=https://your-ignitron-frontend.vercel.app

# ------------------------------------------------------------------------------
# 6. JUDGE0 CODE EXECUTION ENGINE
# ------------------------------------------------------------------------------
# Base URL for self-hosted or managed Judge0 CE execution API
JUDGE0_API_URL=http://localhost:2358
# Optional Judge0 authentication token or RapidAPI key (leave empty if unauthenticated)
JUDGE0_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vite / Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Local dev frontend port
FRONTEND_PORT=5173

# Vercel Production API URL pointing to the deployed Render backend
# Example: https://ignitron-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api
